{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":gitSignOff"],
  "requireConfig": "ignored",
  "gitAuthor": "Renovate Bot <renovate@hollyhome.ath.cx>",
  "baseBranches": [
      "main"
  ],
  "enabledManagers": ["gomod"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "enabled": false,
      "matchPackageNames": [
	      "github.com/openshift/api"
      ]
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "groupName": "all dependencies",
      "matchUpdateTypes": [
        "digest",
        "patch",
        "minor"
      ],
      "enabled": true
    },
    {
      "groupName": "major dependencies",
      "matchUpdateTypes": ["major"],
      "matchDepTypes": ["require"],
      "enabled": true,
      "postUpdateOptions": [
          "gomodUpdateImportPaths"
      ]
    },
{
      "description": "Update of k8s, kubevirt, and controller-runtime needs an additional adjustment",
      "matchPackagePrefixes": [
        "golang.org/x/",
	"google.golang.org/",
        "go.opentelemetry.io/",
	"github.com/onsi/ginkgo/",
	"github.com/go-openapi/",
	"github.com/grpc-ecosystem/",
	"github.com/prometheus/procfs",
	"go.etcd.io/etcd/",
        "k8s.io/",
        "kubevirt.io/",
        "sigs.k8s.io/",
        "github.com/openshift/",
        "github.com/prometheus-operator/"
      ],
      "enabled": false
    },
    {
      "groupName": "ignore",
      "matchUpdateTypes": ["major"],
      "matchDepTypes": ["indirect"],
      "enabled": false
    }
  ],
  "postUpgradeTasks": {
        "commands": [
	    "make vendor",
	    "make generate",
	    "make manifests",
	    "make fmt",
	    "make vet"
        ],
        "executionMode": "branch"
  },
  "prBodyNotes": [
      "### Release note\n```release-note\nUpdate dependecy {{depName}} to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}}\n```\n"
  ]
}
